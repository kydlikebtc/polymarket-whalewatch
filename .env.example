# Dashboard server port for `npm run dev` / `npm run dev:webpack` / `npm start`.
# Default 3000. A PORT set in your shell still wins over this file.
PORT=3000

# Telegram is OPTIONAL. Leave both blank to run the alert engine in record-only
# mode (matches are written to data.sqlite and shown on the 实时告警 dashboard).
# Set BOTH to also push matches to a Telegram channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
LARGE_THRESHOLDS=10000,50000
POLL_INTERVAL_MS=4000
# Optional: point the engine + dashboard at a non-default SQLite file.
# DASH_DB=data.sqlite
# Public base URL of the deployed dashboard — powers the 🎯 signal-card deep
# links in Telegram pushes and bot replies. Defaults to the production site.
# PUBLIC_URL=https://whalewatch.wired.fund

# --- Public-deployment guard -------------------------------------------------
# In production (NODE_ENV=production, i.e. the docker image) the dashboard is
# READ-ONLY for the public: config writes need this token via the x-admin-token
# header (the 告警条件 panel has a token field), and expensive lookup routes are
# per-IP rate limited. Without a token, remote writes are fully disabled.
# ADMIN_TOKEN=change-me-long-random
# Force the guard on/off regardless of NODE_ENV (1/true/yes/on · 0/false/no/off):
# PUBLIC_READONLY=1

# --- Dead-man's switch -------------------------------------------------------
# Optional healthchecks.io / Uptime Kuma push URL. The engine pings it every
# minute while all loops are fresh; if pings stop (crash OR silent hang) the
# service alerts you through a channel independent of this server and Telegram.
# HEALTHCHECK_PING_URL=https://hc-ping.com/<your-uuid>

# --- 信号 feed（供 mm-mobile 后端定时拉取）----------------------------------
# 与 ADMIN_TOKEN 分开：这个是只读的、放在合作方配置里，必须能独立吊销。
# 公开部署下不配置 = feed 关闭（403）。契约见 docs/signals-api.md。
# SIGNAL_FEED_TOKEN=change-me-long-random
